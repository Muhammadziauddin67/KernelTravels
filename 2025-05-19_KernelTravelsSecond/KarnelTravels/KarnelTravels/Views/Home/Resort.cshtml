@{
    ViewBag.Title = "Resort Info";
}

<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url(/assets/images/resort-banner.jpg);">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate pb-5 text-center">
                <p class="breadcrumbs"><span class="mr-2"><a href="/">Home <i class="fa fa-chevron-right"></i></a></span> <span>Resorts <i class="fa fa-chevron-right"></i></span></p>
                <h1 class="mb-0 bread">Resort Information</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section services-section">
    <div class="container">
        <div class="row d-flex">
            <div class="col-md-6 order-md-last heading-section pl-md-5 ftco-animate d-flex align-items-center">
                <div class="w-100">
                    <span class="subheading">Top Resorts</span>
                    <h2 class="mb-4">Find Your Perfect Getaway</h2>
                    <p>We offer premium resort stays with luxury, comfort, and a perfect escape from daily life. Each resort is carefully selected to ensure a peaceful, secure, and adventurous experience.</p>
                    <p><a href="#" class="btn btn-primary py-3 px-4">Explore Resorts</a></p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <!-- Resort Card 1 -->
                    <div class="col-md-12 col-lg-6 d-flex align-self-stretch ftco-animate">
                        <div class="services services-1 color-1 d-block img" style="background-image: url(/assets/images/resort-1.jpg);">
                            <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-hotel"></span></div>
                            <div class="media-body">
                                <h3 class="heading mb-3">Ocean Breeze</h3>
                                <p>Located by the sea with stunning views and premium amenities.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Resort Card 2 -->
                    <div class="col-md-12 col-lg-6 d-flex align-self-stretch ftco-animate">
                        <div class="services services-1 color-2 d-block img" style="background-image: url(/assets/images/resort-2.jpg);">
                            <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-resort"></span></div>
                            <div class="media-body">
                                <h3 class="heading mb-3">Mountain Escape</h3>
                                <p>Relax in nature’s lap with modern facilities in the hills.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Resort Card 3 -->
                    <div class="col-md-12 col-lg-6 d-flex align-self-stretch ftco-animate">
                        <div class="services services-1 color-3 d-block img" style="background-image: url(/assets/images/resort-3.jpg);">
                            <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-swimming-pool"></span></div>
                            <div class="media-body">
                                <h3 class="heading mb-3">Tropical Paradise</h3>
                                <p>Enjoy the sun, sand, and luxury living at our tropical resort.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Resort Card 4 -->
                    <div class="col-md-12 col-lg-6 d-flex align-self-stretch ftco-animate">
                        <div class="services services-1 color-4 d-block img" style="background-image: url(/assets/images/resort-4.jpg);">
                            <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-spa"></span></div>
                            <div class="media-body">
                                <h3 class="heading mb-3">Wellness Retreat</h3>
                                <p>Perfect for those seeking rejuvenation, spa treatments, and peace.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-intro ftco-section ftco-no-pt">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 text-center">
                <div class="img" style="background-image: url(/assets/images/resort-banner.jpg);">
                    <div class="overlay"></div>
                    <h2>Unwind in Luxury</h2>
                    <p>Your next unforgettable vacation begins at one of our exclusive resorts.</p>
                    <p class="mb-0"><a href="#" class="btn btn-primary px-4 py-3">Book Now</a></p>
                </div>
            </div>
        </div>
    </div>
</section>


}