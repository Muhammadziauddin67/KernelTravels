@{
}


<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('/assets/images/bg.jpg');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate pb-5 text-center">
                <p class="breadcrumbs">
                    <span class="mr-2"><a href="index.html">Home <i class="fa fa-chevron-right"></i></a></span>
                    <span>Tourism Spots <i class="fa fa-chevron-right"></i></span>
                </p>
                <h1 class="mb-0 bread">Top Tourist Destinations</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section bg-light">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-7 text-center heading-section ftco-animate">
                <span class="subheading">Discover</span>
                <h2 class="mb-4">Explore Our Top Spots</h2>
                <p>Handpicked destinations that bring you close to nature, culture, and unforgettable experiences.</p>
            </div>
        </div>
        <div class="row">

            <section class="ftco-section">
                <div class="container">
                    <div class="row">
                           @foreach (var tourism in Model)
                            {
                             <div class="col-md-4 ftco-animate">
                               <div class="project-wrap">
                                  <a href="@tourism.TourismLink" class="img" style="background-image: url('/assets/images/@tourism.ImagePath');" target="_blank">
                                     <span class="price">@tourism.Country</span>
                                  </a>
                                <div class="text p-4">
                                 <span class="days">@tourism.Days / Week Tour</span>
                                 <h3><a href="@tourism.TourismLink" target="_blank"><span class="fa fa-map-marker"></span> @tourism.Name</a></h3>
                                 <h6 style="color: darkgoldenrod" ;>
                                            @for (int i = 0; i < tourism.Rating; i++)
                                {
                                 <span class="fa fa-star"></span>
                                 }
                                            @for (int i = tourism.Rating; i < 5; i++)
                                 {
                                  <span class="fa fa-star-o"></span>
                                }</h6> $@tourism.Price / week
                                <ul>
                                            <li><span>@tourism.Location</span></li>
                                </ul>
                                <p><a href="@tourism.TourismLink" target="_blank" class="btn btn-primary py-3 px-3">Book Your Destination</a></p>
                               </div>
                              </div>
                            </div>
                            }
                       
                    </div>
                </div>
                        
            </section>
        </div>
    </div>
</section>
<section class="ftco-intro ftco-section ftco-no-pt">
    <br />
    <br />
    <br />
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 text-center">
                <div class="img" style="background-image: url(/assets/images/bg_2.jpg);">
                    <div class="overlay"></div>
                    <h2>We Are karnel Travel Agency</h2>
                    <p>With us your dream come to reality feel free contact us we are any time avaliable to solve your queries</p>
                    <p class="mb-0"><<a asp-controller="Home" asp-action="Contact" class="nav-link"> class="btn btn-primary px-4 py-3">Contact Us</a></p>
                </div>
            </div>
        </div>
    </div>
</section>