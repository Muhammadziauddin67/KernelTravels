<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url(/assets/images/bg_1.jpg)";>
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate pb-5 text-center">
                <p class="breadcrumbs"><span class="mr-2"><a href="~/assets/index.html">Home <i class="fa fa-chevron-right"></i></a></span> <span>Hotel <i class="fa fa-chevron-right"></i></span></p>
                <h1 class="mb-0 bread">Hotel</h1>
            </div>
        </div>
    </div>
</section>
<section class="ftco-section ftco-no-pb">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="search-wrap-1 ftco-animate">
                    <form action="/Home/Hotel" method="get" class="search-property-1">
                        <div class="row no-gutters">
                            <!-- Destination -->
                            <div class="col-lg d-flex">
                                <div class="form-group p-4 border-0">
                                    <label>Destination</label>
                                    <div class="form-field">
                                        <div class="icon"><span class="fa fa-search"></span></div>
                                        <input type="text" name="destination" class="form-control" placeholder="Search place">
                                    </div>
                                </div>
                            </div>
                            <!-- Hotel Name -->
                            <div class="col-lg d-flex">
                                <div class="form-group p-4">
                                    <label>Hotel Name</label>
                                    <input type="text" name="hotelName" class="form-control" placeholder="e.g. Grand Palace">
                                </div>
                            </div>

                            <!-- Min Rating -->
                            <div class="col-lg d-flex">
                                <div class="form-group p-4">
                                    <label>Minimum Rating</label>
                                    <input type="number" step="0.1" min="0" max="5" name="minRating" class="form-control" placeholder="e.g. 4.5">
                                </div>
                            </div>

                            <!-- Days -->
                            <div class="col-lg d-flex">
                                <div class="form-group p-4">
                                    <label>Days</label>
                                    <input type="text" name="days" class="form-control" placeholder="e.g. 3 days 2 nights">
                                </div>
                            </div>
                            <!-- Max Price -->
                            <div class="col-lg d-flex">
                                <div class="form-group p-4">
                                    <label>Price Limit</label>
                                    <div class="form-field">
                                        <div class="select-wrap">
                                            <div class="icon"><span class="fa fa-chevron-down"></span></div>
                                            <select name="maxPrice" class="form-control">
                                                <option value="">No Limit</option>
                                                <option value="5000">$5,000</option>
                                                <option value="10000">$10,000</option>
                                                <option value="50000">$50,000</option>
                                                <option value="100000">$100,000</option>
                                                <option value="200000">$200,000</option>
                                                <option value="300000">$300,000</option>
                                                <option value="400000">$400,000</option>
                                                <option value="500000">$500,000</option>
                                                <option value="1000000">$1,000,000</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Submit -->
                            <div class="col-lg d-flex">
                                <div class="form-group d-flex w-100 border-0">
                                    <div class="form-field w-100 align-items-center d-flex">
                                        <input type="submit" value="Search" class="align-self-stretch form-control btn btn-primary">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@model IEnumerable<KarnelTravels.Models.Hotel>

<section class="ftco-section">
    <div class="container">
        <div class="row">
            @foreach (var hotel in Model)
            {
                <div class="col-md-4 ftco-animate">
                    <div class="project-wrap hotel">
                        <a href="@hotel.HotelLink" class="img" style="background-image: url('/assets/images/@hotel.ImagePath');" target="_blank">
                            <span class="price">$@hotel.Price / night</span>
                        </a>
                        <div class="text p-4">
                            <p class="star mb-2">
                                @for (int i = 0; i < Math.Round(hotel.Rating); i++)
                                {
                                    <span class="fa fa-star"></span>
                                }
                                @for (int i = (int)Math.Round(hotel.Rating); i < 5; i++)
                                {
                                    <span class="fa fa-star-o"></span>
                                }
                            </p>
                            <span class="days">@hotel.Days / Tour Days </span>
                            <h3><a href="@hotel.HotelLink" target="_blank">@hotel.Name</a></h3>
                            <p class="location"><span class="fa fa-map-marker"></span> @hotel.Location</p>
                            <p class="description">@hotel.Description</p>
                            <ul>
                                <li><span class="flaticon-shower"></span>2</li>
                                <li><span class="flaticon-king-size"></span>3</li>
                                <li><span class="flaticon-sun-umbrella"></span>Near Beach</li>
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>


<section class="ftco-intro ftco-section ftco-no-pt">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 text-center">
                <div class="img" style="background-image: url(/assets/images/bg_2.jpg)";>
                    <div class="overlay"></div>
                    <h2>We Are Karnel A Travel Agency</h2>
                    <p>We can manage your dream building A small river named Duden flows by their place</p>
                    <p class="mb-0"><a href="~/assets/#" class="btn btn-primary px-4 py-3">Ask For A Quote</a></p>
                </div>
            </div>
        </div>
    </div>
</section>
