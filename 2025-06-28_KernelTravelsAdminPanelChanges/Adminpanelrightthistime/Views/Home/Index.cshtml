@{
    ViewData["Title"] = "Home Page";
}

<!-- Page Content -->
<div id="page-content-wrapper" class="w-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-dark border-bottom">
        <div class="container-fluid">
            <button class="btn d-lg-none" id="menu-toggle" type="button">
                <i class="fas fa-bars"></i> Toggle Menu
            </button>
            <h4 class="text-white m-0">Admin Panel</h4>
        </div>
    </nav>

    <div class="container-fluid mt-4">
        <!-- Dashboard Section -->
        <section id="dashboard" class="section-content active">
            <h2>Dashboard</h2>

            <div class="row">
                <div class="col-md-4 mb-4">
                    <canvas id="musicChart" height="200"></canvas>
                </div>
                <div class="col-md-4 mb-4">
                    <canvas id="userGrowthChart" height="200"></canvas>
                </div>
                <div class="col-md-4 mb-4">
                    <canvas id="languageChart" height="200"></canvas>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-4">
                    <canvas id="bookingChart" height="200"></canvas>
                </div>
                <div class="col-md-4 mb-4">
                    <canvas id="seasonalChart" height="200"></canvas>
                </div>
                <div class="col-md-4 mb-4">
                    <canvas id="stayChart" height="200"></canvas>
                </div>
            </div>
        </section>
    </div>
    <</div>
